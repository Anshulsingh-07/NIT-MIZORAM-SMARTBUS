# Flutter runtime configuration uses --dart-define; these values are examples only.
API_BASE_URL=https://nit-mizoram-campus-bus-service.onrender.com
# Optional client key for Google Maps, if used by the selected map provider.
GOOGLE_MAPS_API_KEY=replace_with_restricted_client_key
# Optional client key for Mapbox routing.
MAPBOX_TOKEN=replace_with_restricted_client_token
# Optional Supabase client initialization; the API server uses PostgreSQL directly.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
